<Window x:Class="GlassMusicPlayer.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glass Music Player"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="248"
        SizeToContent="Height"
        FontFamily="Segoe UI"
        Deactivated="OnDeactivated"
        KeyDown="OnKeyDown">
    <Window.Resources>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F2F2F5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}" Padding="10,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#17FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#21FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="GlassBorder"
            CornerRadius="12"
            BorderThickness="1"
            Margin="12"
            Background="#F0141520">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#33FFFFFF" Offset="0"/>
                <GradientStop Color="#14FFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Direction="270" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid>
<Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="16,13,16,8">
                <TextBlock Text="GLASS MUSIC PLAYER"
                           FontSize="10.5" FontWeight="SemiBold" Foreground="#9CA3AF"/>
                <TextBlock x:Name="TrackTitle"
                           Margin="0,4,0,0"
                           FontSize="12.5" Foreground="#F2F2F5"
                           TextTrimming="CharacterEllipsis"
                           Text="—"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="8,0,8,7">
                <Button Style="{StaticResource MenuButton}" Click="OnOpenClick">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://siteoforigin:,,,/icons/tray-open.png" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Открыть плеер" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuButton}" Click="OnPlayPauseClick">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://siteoforigin:,,,/icons/tray-play.png" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Воспроизведение / Пауза" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuButton}" Click="OnNextClick">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://siteoforigin:,,,/icons/tray-next.png" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Следующий трек" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuButton}" Click="OnPrevClick">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://siteoforigin:,,,/icons/tray-prev.png" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Предыдущий трек" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Rectangle Grid.Row="2" Height="1" Margin="12,0" Fill="#14FFFFFF"/>

            <StackPanel Grid.Row="3" Margin="8,7,8,9">
                <Button Style="{StaticResource MenuButton}" Click="OnExitClick">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://siteoforigin:,,,/icons/tray-exit.png" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Выход" VerticalAlignment="Center" Foreground="#F2F2F5"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
